# PostgreSQL — dùng bởi docker compose
POSTGRES_USER=nyachan
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nyachan

# Chuỗi ngẫu nhiên >= 32 ký tự (256 bit) — current_state.md mục 11.
# Tạo nhanh: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_to_a_long_random_string_at_least_32_chars

# Tài khoản Super Admin đầu tiên — chỉ được tạo một lần lúc bảng admins còn rỗng.
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_EMAIL=superadmin@funforum.local
SEED_SUPERADMIN_PASSWORD=CHANGE_ME

# Origin của frontend production, dùng cho CORS.
FRONTEND_ORIGIN=http://localhost:8080

# Google Sign-In — cùng một Web Client ID cho backend và frontend.
# Để trống thì nút Google sẽ ẩn và backend trả 503 nếu gọi endpoint.
GOOGLE_CLIENT_ID=

# SMTP — để trống SMTP_HOST thì email chào mừng/reset chỉ được ghi vào log backend.
# Với Gmail dùng smtp.gmail.com:587 và App Password (không dùng mật khẩu Gmail thường).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Funforum
SMTP_ENABLE_SSL=true

# Tùy chọn — mặc định 500/150 nếu không set (current_state.md mục 3.8).
MAX_REPLIES_PER_THREAD=500
MAX_IMAGES_PER_THREAD=150
