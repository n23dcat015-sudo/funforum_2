<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>nyachan-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- API cơ bản + tài liệu Swagger (GĐ1) -->
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- Data access — Postgres qua EF Core -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Map property PascalCase (C#) <-> cột snake_case (DB) tự động, khớp current_state.md mục 3.2 -->
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />

    <!-- Xác thực JWT (Giai đoạn 2) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />

    <!-- Hash mật khẩu (Giai đoạn 2) -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Xử lý ảnh đính kèm (GĐ3d) — kiểm tra giấy phép Split License trước khi dùng
      (current_state.md mục 3.7). -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

</Project>
